#!/bin/bash
#PBS -N pop_emu_train
#PBS -A UCUB0143
#PBS -q casper
#PBS -l select=1:ncpus=16:ngpus=1:mem=200GB:gpu_type=a100
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /glade/work/acsubram/GitRepos/pop-ocean-emulator/jobs/logs/train.log

# Train the POP ocean emulator on one A100. The global gx1v6 field
# (60 levels x 4 vars + forcing) at batch_size 1 with bf16 fits comfortably;
# raise data.batch_size / model.width once profiled. Requires data/grid_gx1v6.nc
# and data/stats.nc (run jobs/preprocess.pbs first).

set -e
module load conda/latest 2>/dev/null || true
CONDA=/glade/work/acsubram/conda-envs/credit/bin
REPO=/glade/work/acsubram/GitRepos/pop-ocean-emulator
cd $REPO
mkdir -p jobs/logs checkpoints runs

# Always run the current source, never stale bytecode: clear __pycache__ and
# disable .pyc writes. (A stale cache once caused a job to silently run
# pre-merge code despite the working tree being up to date.)
find src -name "__pycache__" -type d -prune -exec rm -rf {} + 2>/dev/null || true
export PYTHONDONTWRITEBYTECODE=1

echo "Job started: $(date) on $(hostname)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

CONFIG=${CONFIG:-configs/default.yaml}
CKPT_DIR=${CKPT_DIR:-checkpoints/default}
echo "config=$CONFIG ckpt_dir=$CKPT_DIR"

RESUME=""
[ -f "$CKPT_DIR/last.pt" ] && RESUME="--resume $CKPT_DIR/last.pt"

$CONDA/python scripts/train.py --config "$CONFIG" $RESUME

echo "Job finished: $(date)"
