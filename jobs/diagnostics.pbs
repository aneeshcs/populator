#!/bin/bash
#PBS -N pop_emu_diag
#PBS -A UCUB0143
#PBS -q casper
#PBS -l select=1:ncpus=8:mem=120GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /glade/work/acsubram/GitRepos/pop-ocean-emulator/jobs/logs/diagnostics.log

# Forced multi-decade rollout + ocean-mode diagnostics (ENSO/PDO/AMO/SST var)
# comparing the emulator to POP. Writes PNGs to docs/figures for the LaTeX report.

set -e
module load conda/latest 2>/dev/null || true
CONDA=/glade/work/acsubram/conda-envs/credit/bin
REPO=/glade/work/acsubram/GitRepos/pop-ocean-emulator
cd $REPO
mkdir -p jobs/logs docs/figures
find src -name "__pycache__" -type d -prune -exec rm -rf {} + 2>/dev/null || true
export PYTHONDONTWRITEBYTECODE=1

CONFIG=${CONFIG:-configs/run2.yaml}
CKPT=${CKPT:-checkpoints/run2/last.pt}
MEMBER=${MEMBER:-001}
T0=${T0:-360}
MONTHS=${MONTHS:-480}
PROJECT=${PROJECT:-0}       # set to 1 to enable conservation projection
BARO_PROJECT=${BARO_PROJECT:-0}  # set to 1 to enable barotropic Poisson projection
OUT=${OUT:-docs/figures}   # output directory for figures and summary

echo "Job started: $(date) on $(hostname)"
echo "config=$CONFIG ckpt=$CKPT member=$MEMBER t0=$T0 months=$MONTHS project=$PROJECT baro_project=$BARO_PROJECT out=$OUT"

mkdir -p "$OUT"

PROJECT_FLAG=""
[ "$PROJECT" = "1" ] && PROJECT_FLAG="--project"
[ "$BARO_PROJECT" = "1" ] && PROJECT_FLAG="$PROJECT_FLAG --baro-project"

$CONDA/python scripts/diagnostics.py --config "$CONFIG" --checkpoint "$CKPT" \
    --member "$MEMBER" --t0 "$T0" --months "$MONTHS" --out "$OUT" $PROJECT_FLAG

echo "Job finished: $(date)"
